<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:id="@+id/sport_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Football"
        android:textSize="26sp" android:textStyle="bold" android:textColor="#222222" />
    <TextView android:id="@+id/sport_description" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Welcome to the sport page." android:textSize="16sp"
        android:textColor="#666666" android:layout_marginTop="10dp" />
    <Button android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Back to My Sports" android:layout_marginTop="24dp" />
</LinearLayout>
